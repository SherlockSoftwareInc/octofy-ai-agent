# =============================================================================
# Octofy AI Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# API Security
# -----------------------------------------------------------------------------
# Legacy system API key (for backward compatibility)
# IMPORTANT: Change this to a secure random string in production
API_KEY=change-this-to-a-secure-key

# JWT Secret for user authentication
# IMPORTANT: Generate a secure random secret key (min 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=***REMOVED***
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL (User Management Database)
# -----------------------------------------------------------------------------
POSTGRES_USER=octofy
POSTGRES_PASSWORD=***REMOVED***
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=octofy_users

# -----------------------------------------------------------------------------
# Milvus Vector Database
# -----------------------------------------------------------------------------
VECTOR_DB_ENABLED=true
MILVUS_HOST=localhost
MILVUS_PORT=19630

# Milvus Collections
MILVUS_COLLECTION_SCHEMA=schema_index
MILVUS_COLLECTION_SCHEMA_V2=schema_index_v2
MILVUS_COLLECTION_FEWSHOT=fewshot_index
MILVUS_COLLECTION_KNOWLEDGE_BASE=knowledge_base
MILVUS_COLLECTION_CONTRIBUTIONS=contribution_library
MILVUS_COLLECTION_VALUES=value_index

# -----------------------------------------------------------------------------
# OpenAI / LLM Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: Custom embedding endpoint
# OPENAI_EMBEDDING_ENDPOINT=https://your-custom-endpoint.com

# LLM (OpenAI compatible) overrides
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Embedding overrides
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector DB overrides
VECTOR_PROVIDER=milvus
VECTOR_HOST=localhost
VECTOR_PORT=19630

# App metadata
APP_NAME=Octofy AI Agent
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Microsoft SQL Server (Data Source)
# -----------------------------------------------------------------------------
# Connection string for your data warehouse/database
# Default: Windows Authentication (Trusted_Connection=yes)
# Format: DRIVER={ODBC Driver 17 for SQL Server};SERVER=server;DATABASE=db;Trusted_Connection=yes
# For SQL Auth: DRIVER={ODBC Driver 17 for SQL Server};SERVER=server;DATABASE=db;UID=user;PWD=pass
SQL_SERVER_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# Code Advisor Settings
# -----------------------------------------------------------------------------
CODE_ADVISOR_RATE_LIMIT=10
CODE_ADVISOR_RATE_WINDOW=60
CODE_ADVISOR_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Docker Deployment (Optional)
# -----------------------------------------------------------------------------
# Set this to change where Docker volumes are stored
# DOCKER_VOLUME_DIRECTORY=./volumes

