# Ignore the virtual environment
### --- Python Core --- ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

### --- Virtual Environments --- ###
# Standard env folders
venv/
.venv/
env/
myenv/
ENV/
env.bak/
venv.bak/

### --- AI & Data (Volumes) --- ###
# Local databases and vector stores
*.db
*.sqlite3
data/
# If you use Milvus or other vector DBs with local persistence
volumes/
volumes/milvus/
milvus_data/
# Large datasets
*.csv
*.jsonl
*.parquet

### --- Secrets & Config --- ###
# Environment variables (NEVER commit these)
.env
.env.*
!.env.example
.flaskenv
secrets.json
myenv/
config/agent_settings.json
skills/
skills/**
# Credential material and key files (never commit)
*.pem
*.key
*.pfx
*.p12
*.jks
credentials*.json
credential*.json
service-account*.json
service_account*.json
secrets*.json
*_secret*.json
# Generated/large artifacts that must not be committed
repomix-output.xml
*.tar.gz
*.zip
logs/
*.log

### --- Docker --- ###
# Ignore local data persistence for Docker containers
.docker_data/
db_data/

### --- Logs & Debugging --- ###
*.log
pip-log.txt
pip-delete-this-directory.txt

### --- Unit Testing --- ###
.pytest_cache/
.tox/
.nox/
.coverage
.cache
htmlcov/

### --- IDEs & Editors --- ###
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/

# System files
.DS_Store
Thumbs.db
NUL

### --- Custom Entries --- ###
context_logs/
context_logs/**
deploy.tar.gz
temp_files/
config/agent_settings.json

### --- Git Worktrees --- ###
# Git worktree directories (should never be committed)
.worktrees/
worktrees/

### --- Local AI Agent & GitHub Tooling (never tracked) --- ###
# Agent/editor scaffolding and GitHub automation kept on disk only.
.agent/
.claude/
.github/
.opencode/
# Git metadata itself is never tracked; listed for completeness.
.git
# Pytest cache is also covered by the Unit Testing section above.
.pytest_cache/
